<Project>
  <!-- Keep build output outside the source folders: the engine folder doubles as a Unity
       package, and Unity would import any DLLs left in bin/ or obj/ as duplicate code. -->
  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory).build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory).build/bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
